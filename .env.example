# DeepSeek credentials (QQ login is handled by SnowLuma)
DEEPSEEK_API_KEY=

# Persona Forge and DSH workspace
DSH_CWD=.
PERSONA_FORGE_ROOT=.

# Optional DSH settings
DSH_PROFILE=qqbot
DSH_PRESET_ROOT=

# Optional QQ Bot endpoints for testing or relay environments
QQBOT_BASE_URL=
QQBOT_TOKEN_BASE_URL=

# Optional runtime flags
QQBOT_BIND_OPEN_BROWSER=1
DSH_PERMISSION_MODE=workspace-write
